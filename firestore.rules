rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Each user owns one profile document (JSON blob for sync + profile/goals/stats fields)
    // and the flat per-day / per-meal rows underneath it. Nobody else can read them from a client;
    // the admin dashboard on Fly.io reads with a service account, which bypasses these rules.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /days/{day}   { allow read, write: if isOwner(uid); }
      match /meals/{meal} { allow read, write: if isOwner(uid); }
      // Progress (body) photo METADATA docs. Bytes live in Storage (see storage.rules). Owner-only, and
      // pin ownerUid == uid on write so a doc can never be written under another account's id.
      match /photos/{photo} {
        allow read: if isOwner(uid);
        // Pin ownerUid == uid on create AND update (owner is effectively immutable: the only value the
        // path-owner can ever write is their own uid). Split out delete: on a delete request.resource is
        // null, so a combined `write` rule that reads request.resource.data.ownerUid silently DENIES every
        // delete — which would break PhotoSync.delete() cross-device. Delete stays owner-only via isOwner.
        allow create, update: if isOwner(uid) && request.resource.data.ownerUid == uid;
        allow delete: if isOwner(uid);
      }
    }
    // Server-side scan log (written by the analyzer with a service account only).
    match /scans/{scan} { allow read, write: if false; }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
